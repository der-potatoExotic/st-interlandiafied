function on_xml_read()
  RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
    if xml_file_name == __mod_interlandiafied_internal_common__.gets_ltx_n("faction_select") then
      local res = xml_obj:query("string[id=" .. __mod_interlandiafied_internal_common__.gets_ltx_n("ecolog_desc") .. "] > text")
      if res[1] then
        local el = res[1]
        local txt = xml_obj:getText(el)
        if txt then
          xml_obj:setText(el, [[Sponsored by Interlandia Ministry of Science.\n 
          \nThey are an official Interlandia unit consisted of scientists and volunteers whose goal is to research the zone and harness its potential.]])
        end
      end
    end
  end)
end